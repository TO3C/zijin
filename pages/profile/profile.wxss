.placeholder-page {
  min-height: 100vh;
}

.profile-card {
  display: flex;
  align-items: center;
  gap: 28rpx;
  margin-top: 70rpx;
  padding: 38rpx;
}

.avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: #ffcf55;
  font-size: 60rpx;
  line-height: 108rpx;
  text-align: center;
}

.name {
  font-size: 34rpx;
  font-weight: 900;
}

.desc {
  margin-top: 12rpx;
  color: #8f8073;
  font-size: 25rpx;
}

.menu-card {
  margin-top: 30rpx;
  padding: 10rpx 30rpx;
}

.menu-card view {
  display: flex;
  justify-content: space-between;
  padding: 34rpx 0;
  border-bottom: 1rpx solid rgba(64, 42, 26, 0.08);
  font-size: 28rpx;
  font-weight: 700;
}

.menu-card view:last-child {
  border-bottom: 0;
}
