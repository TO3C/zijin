.menu-page {
  height: 100vh;
  padding-bottom: 142rpx;
  overflow: hidden;
}

.search-box {
  display: flex;
  align-items: center;
  gap: 14rpx;
  height: 92rpx;
  margin: 42rpx 10rpx 30rpx;
  padding: 0 28rpx;
  border-radius: 52rpx;
  background: rgba(255, 255, 255, 0.86);
  color: #afa69f;
  font-size: 26rpx;
}

.content-row {
  display: flex;
  height: calc(100vh - 334rpx);
  gap: 22rpx;
}

.category-list {
  width: 174rpx;
  height: 100%;
}

.category-item {
  display: flex;
  align-items: center;
  gap: 13rpx;
  height: 92rpx;
  padding-left: 12rpx;
  border-radius: 0 24rpx 24rpx 0;
  color: #57483b;
  font-size: 25rpx;
  font-weight: 700;
}

.category-item.active {
  background: #ffffff;
  color: #ff5a1f;
  box-shadow: 0 10rpx 30rpx rgba(73, 39, 10, 0.07);
}

.cat-icon {
  width: 34rpx;
  font-size: 30rpx;
  text-align: center;
}

.dish-list {
  flex: 1;
  height: 100%;
  padding-right: 4rpx;
}

.banner {
  position: relative;
  height: 258rpx;
  overflow: hidden;
  border-radius: 22rpx;
  background: radial-gradient(circle at 78% 50%, #ff7b23 0 10%, transparent 11%), linear-gradient(120deg, #2b140a, #78431c 44%, #1b0e08);
}

.banner-copy {
  position: absolute;
  z-index: 2;
  left: 34rpx;
  top: 54rpx;
  color: #fff;
}

.banner-copy view {
  font-size: 44rpx;
  font-weight: 900;
}

.banner-copy text {
  display: block;
  margin-top: 18rpx;
  font-size: 28rpx;
}

.badge {
  position: absolute;
  z-index: 2;
  right: 28rpx;
  top: 34rpx;
  width: 86rpx;
  height: 86rpx;
  border: 5rpx solid #211006;
  border-radius: 50%;
  background: #f5a62a;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 33rpx;
  text-align: center;
  transform: rotate(18deg);
  white-space: pre-line;
}

.banner-skewers {
  position: absolute;
  right: -18rpx;
  bottom: 20rpx;
  width: 320rpx;
  height: 118rpx;
  background: repeating-linear-gradient(10deg, #ad3a10 0 22rpx, #ff8c21 22rpx 42rpx, #f3bb67 42rpx 50rpx, transparent 50rpx 70rpx);
  filter: blur(0.4rpx);
  transform: rotate(-10deg);
}

.dish-card {
  position: relative;
  display: flex;
  gap: 22rpx;
  padding: 26rpx 6rpx;
  border-bottom: 1rpx solid rgba(64, 42, 26, 0.08);
}

.food-thumb {
  width: 150rpx;
  height: 150rpx;
  flex: none;
  border-radius: 14rpx;
  background-color: #21130d;
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.08);
}

.skewer-one,
.skewer-two {
  background: repeating-linear-gradient(20deg, transparent 0 23rpx, #d6892e 23rpx 31rpx, #83270e 31rpx 44rpx, #ff7a18 44rpx 58rpx, transparent 58rpx 76rpx), radial-gradient(circle at 70% 18%, #ff531b, transparent 22%), #160e0b;
}

.skewer-two {
  filter: saturate(1.25);
}

.oyster {
  background: radial-gradient(ellipse at 34% 42%, #ff8f2d 0 14%, #ffe6b4 15% 26%, #5a3923 27% 42%, transparent 43%), radial-gradient(ellipse at 70% 54%, #ff7a22 0 15%, #ffe2a2 16% 26%, #4f321e 27% 43%, transparent 44%), #1d120e;
}

.eggplant {
  background: linear-gradient(145deg, #1a120f 20%, #4a220f 20% 56%, #ff5a1f 56% 68%, #28120c 68%), radial-gradient(circle at 70% 40%, #f7b04b, transparent 28%);
}

.chive {
  background: repeating-linear-gradient(14deg, #173611 0 13rpx, #39a333 13rpx 22rpx, #ff651e 22rpx 28rpx, transparent 28rpx 44rpx), #120d0a;
}

.corn {
  background: repeating-linear-gradient(6deg, #ffb32e 0 20rpx, #ff7f1f 20rpx 33rpx, #ffcc52 33rpx 48rpx, transparent 48rpx 62rpx), #1f1209;
}

.dish-info {
  min-width: 0;
  flex: 1;
  padding-top: 4rpx;
}

.dish-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.dish-name {
  font-size: 30rpx;
  font-weight: 900;
}

.dish-tag {
  padding: 4rpx 8rpx;
  border-radius: 6rpx;
  background: #ff5a1f;
  color: #fff;
  font-size: 20rpx;
  font-weight: 800;
}

.dish-desc {
  margin: 16rpx 0 18rpx;
  color: #9b8d82;
  font-size: 23rpx;
}

.unit {
  color: #6c5a4c;
  font-size: 22rpx;
}

.add-btn {
  position: absolute;
  right: 2rpx;
  bottom: 32rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #3a210f;
  color: #fff;
  font-size: 34rpx;
  line-height: 40rpx;
  padding: 0;
}

.cart-bar {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: 28rpx;
  display: flex;
  align-items: center;
  height: 100rpx;
  padding: 0 22rpx;
  border-radius: 54rpx;
  background: linear-gradient(90deg, #3f220d, #2b1609 76%, #120b07);
  color: #fff;
  box-shadow: 0 12rpx 30rpx rgba(44, 23, 8, 0.25);
}

.cart-icon {
  position: relative;
  width: 76rpx;
  font-size: 52rpx;
}

.cart-badge {
  position: absolute;
  right: -6rpx;
  top: -12rpx;
  min-width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: #ff5a1f;
  font-size: 23rpx;
  line-height: 42rpx;
  text-align: center;
}

.cart-summary {
  flex: 1;
  padding-left: 14rpx;
}

.cart-summary view {
  font-size: 32rpx;
  font-weight: 900;
}

.cart-summary text {
  color: #d7c7b7;
  font-size: 22rpx;
}

.order-btn {
  width: 172rpx;
  height: 72rpx;
  border-radius: 44rpx;
  background: linear-gradient(180deg, #ffd256, #ffbe2c);
  color: #201006;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 72rpx;
}
