<view class="safe-page menu-page">
  <view class="status-bar">
    <text>9:41</text>
    <view class="status-icons"><view class="signal"></view><view class="wifi"></view><view class="battery"></view></view>
  </view>
  <view class="topbar">
    <view class="page-title">点单 <text class="hand-note">好吃！</text></view>
    <view class="capsule"><text class="dot-more">•••</text><view class="capsule-circle"></view></view>
  </view>

  <view class="search-box">⌕ <text>搜索菜品</text></view>

  <view class="content-row">
    <scroll-view class="category-list" scroll-y="true">
      <view wx:for="{{categories}}" wx:key="id" class="category-item {{activeCategory === item.id ? 'active' : ''}}" bindtap="selectCategory" data-id="{{item.id}}">
        <text class="cat-icon">{{item.icon}}</text><text>{{item.name}}</text>
      </view>
    </scroll-view>

    <scroll-view class="dish-list" scroll-y="true">
      <view class="banner">
        <view class="banner-copy"><view>招牌必点</view><text>必尝美味</text></view>
        <view class="badge">店主\n推荐</view>
        <view class="banner-skewers"></view>
      </view>

      <view wx:for="{{filteredDishes}}" wx:key="id" class="dish-card">
        <view class="food-thumb {{item.imageClass}}"></view>
        <view class="dish-info">
          <view class="dish-title-row"><text class="dish-name">{{item.name}}</text><text wx:if="{{item.tag}}" class="dish-tag">{{item.tag}}</text></view>
          <view class="dish-desc">{{item.desc}}</view>
          <view><text class="price">¥{{item.price}}</text><text class="unit">/{{item.unit}}</text></view>
        </view>
        <button class="add-btn" hover-class="none" bindtap="addDish" data-id="{{item.id}}">＋</button>
      </view>
    </scroll-view>
  </view>

  <view class="cart-bar">
    <view class="cart-icon">♨<text wx:if="{{totalCount}}" class="cart-badge">{{totalCount}}</text></view>
    <view class="cart-summary"><view>¥{{totalPrice}}</view><text>已选 {{totalCount}} 件</text></view>
    <button class="order-btn" hover-class="none" bindtap="goConfirm">去下单</button>
  </view>
</view>
