page {
  min-height: 100%;
  background: #fff8ed;
  color: #26170f;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', Arial, sans-serif;
}

.safe-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 72rpx 28rpx 36rpx;
  background:
    radial-gradient(circle at 14% 8%, rgba(255, 206, 125, 0.3), transparent 28%),
    linear-gradient(180deg, #fff8ed 0%, #fffdf8 42%, #fff8ef 100%);
}

.status-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 48rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #070707;
}

.status-icons {
  display: flex;
  gap: 8rpx;
  align-items: center;
}

.signal {
  width: 34rpx;
  height: 24rpx;
  background: linear-gradient(90deg, #111 20%, transparent 20% 30%, #111 30% 50%, transparent 50% 60%, #111 60% 80%, transparent 80%);
  border-radius: 3rpx;
}

.wifi {
  width: 28rpx;
  height: 22rpx;
  border: 5rpx solid #111;
  border-bottom: 0;
  border-radius: 28rpx 28rpx 0 0;
}

.battery {
  position: relative;
  width: 44rpx;
  height: 22rpx;
  border: 3rpx solid #111;
  border-radius: 5rpx;
}

.battery::after {
  content: '';
  position: absolute;
  right: -8rpx;
  top: 5rpx;
  width: 5rpx;
  height: 10rpx;
  background: #111;
  border-radius: 0 3rpx 3rpx 0;
}

.battery::before {
  content: '';
  position: absolute;
  left: 4rpx;
  top: 4rpx;
  width: 30rpx;
  height: 10rpx;
  background: #111;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 34rpx;
}

.page-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 38rpx;
  font-weight: 900;
  letter-spacing: -1rpx;
}

.hand-note {
  color: #ff5a1f;
  font-size: 24rpx;
  font-weight: 800;
  transform: rotate(-8deg);
}

.capsule {
  display: flex;
  align-items: center;
  justify-content: space-around;
  width: 172rpx;
  height: 58rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 0 8rpx 25rpx rgba(77, 40, 12, 0.08);
}

.dot-more {
  font-size: 34rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
}

.capsule-circle {
  width: 36rpx;
  height: 36rpx;
  border: 5rpx solid #111;
  border-radius: 50%;
}

.card {
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.86);
  box-shadow: 0 14rpx 38rpx rgba(98, 53, 13, 0.09);
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 110rpx;
  border-radius: 60rpx;
  background: linear-gradient(180deg, #ffd04f 0%, #ffbd29 100%);
  box-shadow: 0 12rpx 22rpx rgba(255, 173, 37, 0.32);
  color: #201006;
  font-size: 34rpx;
  font-weight: 900;
}

.price {
  color: #ff5a1f;
  font-weight: 900;
}
