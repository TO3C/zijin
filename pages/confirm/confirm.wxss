.confirm-page {
  padding-bottom: 44rpx;
}

.confirm-topbar {
  gap: 18rpx;
}

.back {
  width: 42rpx;
  font-size: 62rpx;
  line-height: 58rpx;
  color: #1a120d;
}

.confirm-topbar .page-title {
  flex: 1;
  font-size: 33rpx;
}

.table-banner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 188rpx;
  margin-top: 42rpx;
  padding: 24rpx 30rpx;
  overflow: hidden;
  background: linear-gradient(90deg, rgba(255, 240, 214, 0.98), rgba(255, 249, 239, 0.92));
}

.table-no {
  font-size: 53rpx;
  font-weight: 900;
}

.table-label {
  margin-left: 10rpx;
  font-size: 27rpx;
}

.guest-text {
  margin-top: 16rpx;
  color: #665647;
  font-size: 26rpx;
}

.couple-mini {
  position: relative;
  width: 220rpx;
  height: 150rpx;
}

.mini-person {
  position: absolute;
  bottom: 0;
  width: 86rpx;
  height: 130rpx;
  border-radius: 45rpx 45rpx 22rpx 22rpx;
  background: linear-gradient(180deg, #ffd3aa 0 42%, #24201e 42%);
  box-shadow: inset 0 20rpx 0 #2b160d;
}

.boy-mini { left: 20rpx; }
.girl-mini { right: 20rpx; background: linear-gradient(180deg, #ffd0a2 0 42%, #f1d7bc 42% 58%, #2a211d 58%); box-shadow: inset 0 22rpx 0 #6a2b10; }

.tip-row {
  display: flex;
  gap: 12rpx;
  margin: 34rpx 8rpx;
  color: #6a5848;
  font-size: 25rpx;
}

.order-card {
  padding: 8rpx 26rpx;
}

.order-item {
  display: flex;
  align-items: center;
  gap: 22rpx;
  min-height: 176rpx;
  border-bottom: 1rpx solid rgba(64, 42, 26, 0.08);
}

.order-item:last-child {
  border-bottom: 0;
}

.food-thumb {
  width: 126rpx;
  height: 126rpx;
  flex: none;
  border-radius: 12rpx;
  background-color: #21130d;
}

.skewer-one,
.skewer-two {
  background: repeating-linear-gradient(20deg, transparent 0 23rpx, #d6892e 23rpx 31rpx, #83270e 31rpx 44rpx, #ff7a18 44rpx 58rpx, transparent 58rpx 76rpx), #160e0b;
}

.skewer-two { filter: saturate(1.25); }

.oyster {
  background: radial-gradient(ellipse at 34% 42%, #ff8f2d 0 14%, #ffe6b4 15% 26%, #5a3923 27% 42%, transparent 43%), radial-gradient(ellipse at 70% 54%, #ff7a22 0 15%, #ffe2a2 16% 26%, #4f321e 27% 43%, transparent 44%), #1d120e;
}

.eggplant {
  background: linear-gradient(145deg, #1a120f 20%, #4a220f 20% 56%, #ff5a1f 56% 68%, #28120c 68%);
}

.order-info {
  flex: 1;
}

.order-name {
  margin-bottom: 22rpx;
  font-size: 28rpx;
  font-weight: 900;
}

.unit {
  color: #6c5a4c;
  font-size: 22rpx;
}

.qty-control {
  display: flex;
  align-items: center;
  gap: 18rpx;
  font-size: 29rpx;
  font-weight: 900;
}

.qty-control button {
  width: 40rpx;
  height: 40rpx;
  padding: 0;
  border-radius: 50%;
  border: 2rpx solid #c9c0b7;
  background: #fff;
  color: #8c837b;
  font-size: 32rpx;
  line-height: 34rpx;
}

.qty-control .plus {
  border-color: #3a210f;
  background: #3a210f;
  color: #fff;
}

.item-total {
  width: 64rpx;
  text-align: right;
  font-size: 29rpx;
  font-weight: 900;
}

.remark {
  box-sizing: border-box;
  width: 100%;
  height: 82rpx;
  margin-top: 32rpx;
  padding: 0 30rpx;
  font-size: 25rpx;
}

.remark-placeholder {
  color: #b8aea4;
}

.bill {
  margin-top: 18rpx;
  padding: 28rpx 30rpx;
  font-size: 28rpx;
}

.bill view {
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.bill .bill-total {
  margin: 30rpx 0 0;
  padding-top: 28rpx;
  border-top: 1rpx solid rgba(64, 42, 26, 0.08);
  font-weight: 900;
}

.bill-total .price {
  font-size: 48rpx;
}

.submit-btn {
  margin: 34rpx 10rpx 24rpx;
}

.footer-tip {
  color: #9d9085;
  font-size: 25rpx;
  text-align: center;
}
